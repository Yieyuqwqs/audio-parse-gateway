# 复制成 env 再填值，install.sh 会自动搬到 ~/audio-parse-gateway/.env
# QQ 音乐（qm_keyst + uin 才算登录）
# ENABLE_QQ=1
# TX_UIN=你的QQ号
# TX_COOKIE=qm_keyst=...; uin=o0你的QQ号
# 网易云（有会员 cookie 才有无损）
# ENABLE_NETEASE=1
# NETEASE_COOKIE=MUSIC_U=...

# 酷我 / 酷狗 / 咪咕：零凭据直连，默认就开着（想关掉设 0）
# ENABLE_KUWO=1
# ENABLE_KUGOU=1
# ENABLE_MIGU=1
# 有会员账号再加上这些，才能解锁 flac / HQ
# KW_COOKIE=
# KG_COOKIE=
# MG_COOKIE=
# MG_USER_ID=
